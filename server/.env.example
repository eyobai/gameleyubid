# ── Runtime ──
NODE_ENV=development
PORT=3100
# Comma-separated origins allowed to call the API from a browser (the Vite dev server in development).
CORS_ORIGINS=http://localhost:5180
# Public address of the site. Chapa sends players back to <PUBLIC_URL>/wallet after paying.
PUBLIC_URL=http://localhost:5180
# Set to ../web/dist to serve the built player site from this server (one address for everything).
WEB_DIST_DIR=
# true when behind a reverse proxy / load balancer, so rate limits see the real client IP.
TRUST_PROXY=false

DATABASE_URL=postgresql://updraft:updraft_dev_password@localhost:5433/updraft?schema=public

# ── Sign-in ── (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# ── Money ──
CURRENCY=ETB
CURRENCY_MINOR_UNITS=2

# ── Game ──
# Off by default. Real-money play needs a license from the National Lottery Administration first.
GAME_ENABLED=false
# House edge in basis points: 300 = 3%. Every strategy returns (100% - edge) of what is bet over time.
GAME_EDGE_BPS=300
# The most one bet can cost the house, as a share of the reserve (not counting bets still in the air): 100 = 1%.
GAME_FLIGHT_RISK_BPS=100
# The most all open flights together can cost the house, as a share of the same amount: 1000 = 10%.
GAME_TOTAL_RISK_BPS=1000
# Highest multiplier anyone can be paid at, ×100: 100000 = 1000.00×.
GAME_MAX_MULTIPLIER_X100=100000
# Bet limits in minor units (santim): 100 = 1.00 ETB, 1000000 = 10,000.00 ETB.
GAME_MIN_BET_MINOR=100
GAME_MAX_BET_MINOR=1000000
# Betting window before each round lifts off (ms).
GAME_BETTING_MS=7000
# How often (ms) the round engine settles cash-outs and starts and ends rounds.
GAME_TICK_MS=100
# Rounds per hash chain. A new chain (with a new published commitment) starts when one runs out.
GAME_CHAIN_LENGTH=100000
# Mixed into every round's pop point. For the strongest guarantee, publish the chain commitment first and then set
# this to a value nobody could know in advance (e.g. a future lottery draw or block hash).
GAME_CHAIN_SALT=updraft

# ── Deposits (Chapa) ──
# "none" turns deposits off. CHASECK_TEST-... is test mode; CHASECK-... is live and takes real money.
PAYMENT_PROVIDER=none
CHAPA_SECRET_KEY=
# The secret hash set in Chapa's webhook settings (16+ characters). Empty: webhooks are refused and deposits are
# confirmed by Chapa's callback, the player returning from checkout, and the background check.
CHAPA_WEBHOOK_SECRET=
DEPOSIT_MIN_MINOR=1000
DEPOSIT_MAX_MINOR=10000000
DEPOSIT_EXPIRY_MINUTES=60
PAYMENT_SWEEP_INTERVAL_SECONDS=60

# ── Rate limits (requests per minute per IP) ──
THROTTLE_LIMIT=600
AUTH_THROTTLE_LIMIT=10
